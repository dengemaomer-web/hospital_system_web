@model List<AppointmentViewModel>
@{
    ViewData["Title"] = "Günlük Randevular";
    var selectedDate = (DateTime)(ViewBag.SelectedDate ?? DateTime.Today);
}
<div class="page-head">
    <div><h1>Günlük Randevular</h1><div class="crumb">@selectedDate.ToString("dd MMMM yyyy, dddd")</div></div>
    <form method="get" class="flex gap-2">
        <input type="date" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" class="form-input" />
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-filter"></i> Göster</button>
    </form>
</div>

<div class="card-glass">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><i class="fa-regular fa-calendar"></i><div>Bu tarih için randevu bulunmuyor.</div></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Saat</th><th>Hasta</th><th>Poliklinik</th><th>Not</th><th>Durum</th><th>İşlemler</th></tr></thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td><strong>@a.TimeSlot</strong></td>
                        <td>@a.PatientName</td>
                        <td>@a.DepartmentName</td>
                        <td class="text-secondary">@(string.IsNullOrEmpty(a.Notes) ? "-" : a.Notes)</td>
                        <td><partial name="_StatusBadge" model="a.Status" /></td>
                        <td>
                            <div class="flex gap-2 flex-wrap">
                                <a asp-action="PatientHistory" asp-route-id="@a.PatientId" class="btn btn-sm btn-soft"><i class="fa-solid fa-clock-rotate-left"></i></a>
                                @if (a.Status == AppointmentStatus.Pending)
                                {
                                    <form asp-action="ConfirmAppointment" method="post" style="margin:0">
                                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.Id" />
                                        <button class="btn btn-sm btn-accent"><i class="fa-solid fa-check"></i> Onayla</button>
                                    </form>
                                }
                                @if (a.Status != AppointmentStatus.Completed && a.Status != AppointmentStatus.Cancelled)
                                {
                                    <a asp-action="WritePrescription" asp-route-appointmentId="@a.Id" class="btn btn-sm btn-primary"><i class="fa-solid fa-prescription"></i> Reçete</a>
                                    <form asp-action="CompleteAppointment" method="post" style="margin:0">
                                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.Id" />
                                        <button class="btn btn-sm btn-success"><i class="fa-solid fa-clipboard-check"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
