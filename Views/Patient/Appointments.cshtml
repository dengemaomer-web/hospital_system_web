@model List<AppointmentViewModel>
@{
    ViewData["Title"] = "Randevularım";
}
<div class="page-head">
    <div><h1>Randevularım</h1><div class="crumb">Tüm randevu geçmişiniz</div></div>
    <a asp-action="Book" class="btn btn-primary"><i class="fa-solid fa-calendar-plus"></i> Yeni Randevu</a>
</div>

<div class="card-glass">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><i class="fa-regular fa-calendar"></i><div>Henüz randevunuz bulunmuyor.</div></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Doktor</th><th>Poliklinik</th><th>Tarih</th><th>Saat</th><th>Durum</th><th>İşlem</th></tr></thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.DoctorName</td>
                        <td>@a.DepartmentName</td>
                        <td>@a.Date.ToString("dd.MM.yyyy")</td>
                        <td>@a.TimeSlot</td>
                        <td><partial name="_StatusBadge" model="a.Status" /></td>
                        <td>
                            @if (a.Status == AppointmentStatus.Pending || a.Status == AppointmentStatus.Confirmed)
                            {
                                <form asp-action="Cancel" method="post" onsubmit="return confirm('Randevuyu iptal etmek istediğinize emin misiniz?');" style="margin:0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger"><i class="fa-solid fa-xmark"></i> İptal</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-secondary">-</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
