@model List<Notification>
<div class="card-glass">
    <div class="flex items-center justify-between" style="margin-bottom:16px">
        <h2 class="card-title mb-0"><i class="fa-solid fa-bell c-primary"></i> Bildirimler</h2>
        <form asp-controller="Notification" asp-action="MarkAllRead" method="post" style="margin:0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-soft">Tümünü Okundu İşaretle</button>
        </form>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><i class="fa-regular fa-bell-slash"></i><div>Henüz bildiriminiz yok.</div></div>
    }
    else
    {
        foreach (var n in Model)
        {
            var (ico, color) = n.Type switch
            {
                NotificationType.NewAppointment => ("fa-calendar-plus", "primary"),
                NotificationType.UpcomingAppointment => ("fa-calendar-day", "accent"),
                NotificationType.CancelledAppointment => ("fa-calendar-xmark", "danger"),
                NotificationType.PrescriptionCreated => ("fa-prescription", "success"),
                _ => ("fa-bullhorn", "warning")
            };
            <div class="dropdown-item-custom @(n.IsRead ? "" : "unread")" style="border-bottom:1px solid var(--border);border-radius:0">
                <div class="ico bg-@(color)-soft"><i class="fa-solid @ico"></i></div>
                <div style="flex:1">
                    <div class="t">@n.Title</div>
                    <div class="d">@n.Message</div>
                    <div class="d" style="margin-top:4px;opacity:.7">@n.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                </div>
                @if (!n.IsRead)
                {
                    <span class="badge badge-confirmed">Yeni</span>
                }
            </div>
        }
    }
</div>
