@model List<LogEntry>
@{
    ViewData["Title"] = "Log Yönetimi";
    string LevelBadge(HospitalSystem.Models.Enums.LogLevel l) => l switch
    {
        HospitalSystem.Models.Enums.LogLevel.Error => "badge-cancelled",
        HospitalSystem.Models.Enums.LogLevel.Warning => "badge-pending",
        _ => "badge-confirmed"
    };
}
<div class="page-head"><div><h1>Log Yönetimi</h1><div class="crumb">Sistem olay kayıtları (son 300)</div></div></div>

<div class="card-glass">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><i class="fa-solid fa-list-check"></i><div>Kayıt yok.</div></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Zaman</th><th>Seviye</th><th>Kaynak</th><th>Mesaj</th></tr></thead>
                <tbody>
                @foreach (var l in Model)
                {
                    <tr>
                        <td class="text-secondary" style="white-space:nowrap">@l.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td><span class="badge @LevelBadge(l.Level)">@l.Level</span></td>
                        <td>@l.Source</td>
                        <td>@l.Message</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
