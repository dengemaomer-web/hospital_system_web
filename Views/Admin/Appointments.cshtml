@model List<AppointmentViewModel>
@{
    ViewData["Title"] = "Randevu Yönetimi";
}
<div class="page-head"><div><h1>Randevu Yönetimi</h1><div class="crumb">Sistemdeki tüm randevular</div></div></div>

<div class="card-glass">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><i class="fa-regular fa-calendar"></i><div>Randevu bulunmuyor.</div></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Hasta</th><th>Doktor</th><th>Poliklinik</th><th>Tarih</th><th>Saat</th><th>Durum</th><th>İşlem</th></tr></thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.PatientName</td><td>@a.DoctorName</td><td>@a.DepartmentName</td>
                        <td>@a.Date.ToString("dd.MM.yyyy")</td><td>@a.TimeSlot</td>
                        <td><partial name="_StatusBadge" model="a.Status" /></td>
                        <td>
                            @if (a.Status != AppointmentStatus.Cancelled && a.Status != AppointmentStatus.Completed)
                            {
                                <form asp-action="CancelAppointment" method="post" onsubmit="return confirm('İptal edilsin mi?');" style="margin:0">
                                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.Id" />
                                    <button class="btn btn-sm btn-danger"><i class="fa-solid fa-xmark"></i> İptal</button>
                                </form>
                            }
                            else { <span class="text-secondary">-</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
